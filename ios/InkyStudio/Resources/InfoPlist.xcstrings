{
  "sourceLanguage": "fr",
  "strings": {
    "NSBluetoothAlwaysUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يستخدم Inky Studio البلوتوث للتعرّف على إطار الصور وإعداد اتصاله بشبكة Wi‑Fi، حتى عندما تكون بعيدًا عن شبكتك المعتادة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio verwendet Bluetooth, um Ihren Bilderrahmen zu erkennen und seine WLAN-Verbindung einzurichten, auch außerhalb Ihres gewohnten Netzwerks."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inky Studio uses Bluetooth to recognise your frame and set up its Wi-Fi, even when you are away from your usual network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio usa Bluetooth para reconocer tu marco digital y configurar su conexión Wi‑Fi, incluso fuera de tu red habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inky Studio utilise le Bluetooth pour reconnaître votre cadre et configurer son réseau Wi-Fi, même hors de votre réseau habituel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio usa il Bluetooth per riconoscere la tua cornice digitale e configurarne il Wi‑Fi, anche quando sei fuori dalla tua rete abituale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studioは、フォトフレームの識別とWi‑Fiの設定にBluetoothを使用します。普段使っているネットワークの外でも設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio는 Bluetooth를 사용해 디지털 액자를 식별하고 Wi‑Fi 연결을 설정합니다. 평소 사용하는 네트워크 밖에서도 설정할 수 있습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Inky Studio usa o Bluetooth para identificar a moldura digital e configurar a ligação Wi‑Fi, mesmo fora da rede habitual."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio 使用蓝牙识别您的数码相框并设置其 Wi‑Fi 连接，即使您不在常用网络中也能进行设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio 使用藍牙辨識您的數位相框並設定 Wi‑Fi 連線，即使您不在平常使用的網路中也能設定。"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "التقط صورة لعرضها على إطارك أو امسح رمز QR لإقرانه. لا تُحفظ الصور التي تلتقطها هنا تلقائيًا في مكتبة الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nehmen Sie ein Foto für Ihren Bilderrahmen auf oder scannen Sie seinen QR-Code zur Kopplung. Hier aufgenommene Fotos werden nicht automatisch in Ihrer Fotomediathek gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo for your frame or scan its pairing QR code. Photos you take here are never automatically saved to your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Haz una foto para tu marco digital o escanea su código QR para vincularlo. Las fotos que hagas aquí no se guardan automáticamente en tu fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo pour votre cadre ou scannez son QR de connexion. Les images ne sont pas enregistrées automatiquement dans votre photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scatta una foto per la tua cornice digitale oppure scansiona il codice QR per abbinarla. Le foto scattate qui non vengono salvate automaticamente nella libreria foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォトフレームに表示する写真を撮影したり、ペアリング用のQRコードを読み取ったりできます。ここで撮影した写真は写真ライブラリに自動保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "디지털 액자에 표시할 사진을 찍거나 페어링용 QR 코드를 스캔합니다. 여기서 찍은 사진은 사진 보관함에 자동으로 저장되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tire uma fotografia para a moldura digital ou leia o código QR para a emparelhar. As fotografias tiradas aqui não são guardadas automaticamente na fototeca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "为数码相框拍摄照片，或扫描配对二维码。在此拍摄的照片不会自动保存到您的照片图库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "為數位相框拍攝照片，或掃描配對用的 QR 碼。在這裡拍攝的照片不會自動儲存到您的照片圖庫。"
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تتيح ميزة Face ID فتح قفل Inky Studio وتحمي الوصول من هذا الـ iPhone إلى الصور الموجودة على إطارك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Face ID entsperrt Inky Studio und schützt auf diesem iPhone den Zugriff auf die Fotos Ihres Bilderrahmens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID unlocks Inky Studio and protects access to your frame’s photos on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Face ID desbloquea Inky Studio y protege el acceso desde este iPhone a las fotos de tu marco digital."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID déverrouille Inky Studio et protège l’accès aux photos de votre cadre sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Face ID sblocca Inky Studio e protegge l’accesso da questo iPhone alle foto della tua cornice digitale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Face IDでInky Studioのロックを解除し、このiPhoneからフォトフレームの写真にアクセスする際の保護に使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Face ID로 Inky Studio의 잠금을 해제하고, 이 iPhone에서 디지털 액자의 사진에 접근할 때 이를 보호합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Face ID desbloqueia o Inky Studio e protege o acesso, a partir deste iPhone, às fotografias da moldura digital."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "面容 ID 可解锁 Inky Studio，并保护您从这部 iPhone 访问数码相框中的照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Face ID 可解鎖 Inky Studio，並保護您從這部 iPhone 取用數位相框中的照片。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يتحقق Inky Studio من إطارك عبر شبكة Wi‑Fi المؤقتة الخاصة به لإعداده، ثم يتصل به عبر شبكتك لإدارة صوره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Für die Einrichtung überprüft Inky Studio Ihren Bilderrahmen über dessen temporäres WLAN. Anschließend verbindet sich die App über Ihr WLAN mit dem Rahmen, um seine Fotos zu verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inky Studio connects to your frame to set it up and manage the photos on your local Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio verifica tu marco digital a través de su red Wi‑Fi temporal para configurarlo. Después se conecta a través de tu red Wi‑Fi para gestionar sus fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inky Studio vérifie votre cadre sur son Wi-Fi temporaire pour le configurer, puis sur votre réseau Wi-Fi pour gérer ses photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Per configurare la cornice digitale, Inky Studio la verifica tramite la sua rete Wi‑Fi temporanea. In seguito si connette tramite la tua rete Wi‑Fi per gestirne le foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studioは、設定時にフォトフレームの一時的なWi‑Fiでフレームを確認し、その後はお使いのWi‑Fiで接続して写真を管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inky Studio는 초기 설정을 위해 디지털 액자의 임시 Wi‑Fi에 연결해 액자를 확인합니다. 이후에는 사용자의 Wi‑Fi를 통해 액자의 사진을 관리합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Para configurar a moldura digital, o Inky Studio verifica-a através da sua rede Wi‑Fi temporária. Depois, liga-se através da sua rede Wi‑Fi para gerir as fotografias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "设置时，Inky Studio 通过数码相框的临时 Wi‑Fi 验证相框。设置完成后，应用会通过您的 Wi‑Fi 连接相框以管理照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "設定時，Inky Studio 會透過數位相框的暫用 Wi‑Fi 驗證相框。設定完成後，App 會透過您的 Wi‑Fi 連線到相框來管理照片。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
