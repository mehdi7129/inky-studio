    "Maintenez une photo pour ouvrir ses options, ou touchez Modifier la file pour changer l’ordre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط على الصورة وإمسكها للحصول على المزيد من الخيارات، أو اضغط على صف التحرير لتغيير الترتيب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Berühren Sie ein Foto und halten Sie es für weitere Optionen oder tippen Sie auf \"Bearbeiten\" in der Warteschlange, um die Reihenfolge zu ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold a photo for more options, or tap Edit queue to change the order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque y mantenga una foto para obtener más opciones, o toque la cola de edición para cambiar el orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez une photo pour ouvrir ses options, ou touchez Modifier la file pour changer l’ordre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toccare e trattenere una foto per altre opzioni, o toccare Edit fila per modificare l'ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォトをタッチして,より多くのオプションを表示します. または,順番を変更するには,編集列をタッチします."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "더 많은 옵션을 위해 사진을 만지고 유지하거나 순서를 변경하기 위해 편집 줄을 누르십시오."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque e mantenha uma foto para obter mais opções, ou toque na fila de edição para alterar a ordem."
