    "Sur cet iPhone, ouvrez Réglages → Wi-Fi et rejoignez « %@ ». Revenez ensuite dans Inky Studio pour terminer la vérification.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على هذا الـ iPhone، افتح الإعدادات ← Wi-Fi وانضم إلى «%@». ثم ارجع إلى Inky Studio لإتمام التحقق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie auf diesem iPhone Einstellungen → WLAN und verbinden Sie sich mit „%@“. Kehren Sie für die Prüfung zu Inky Studio zurück."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On this iPhone, open Settings → Wi-Fi and join “%@”. Return to Inky Studio to finish verification."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En este iPhone, abre Ajustes → Wi-Fi y conéctate a «%@». Vuelve a Inky Studio para completar la verificación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur cet iPhone, ouvrez Réglages → Wi-Fi et rejoignez « %@ ». Revenez ensuite dans Inky Studio pour terminer la vérification."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo iPhone, apri Impostazioni → Wi-Fi e collegati a «%@». Torna a Inky Studio per completare la verifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このiPhoneで「設定」→「Wi-Fi」を開き、「%@」に接続します。Inky Studioに戻って確認を完了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 iPhone에서 설정 → Wi-Fi를 열고 ‘%@’에 연결하세요. Inky Studio로 돌아와 확인을 마치세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Neste iPhone, abra Definições → Wi-Fi e ligue-se à rede «%@». Volte ao Inky Studio para concluir a verificação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 上打开“设置”→“Wi-Fi”，加入“%@”，然后返回 Inky Studio 完成验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此 iPhone 上開啟「設定」→「Wi-Fi」，加入「%@」，再回到 Inky Studio 完成驗證。"
          }
        }
      }
    },
