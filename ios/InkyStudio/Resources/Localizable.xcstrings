          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prendi una foto o scegli una da Photos, poi regola il raccolto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写真から写真を撮り,作物を調整します."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진을 찍거나 사진에서 하나를 선택하고 작물을 조정하십시오."
          }
        },
        "pt": {
          "stringUnit": {
