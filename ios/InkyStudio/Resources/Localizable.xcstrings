    "L’essai sera annulé s’il n’est pas confirmé dans %lld s.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُلغى الاختبار ما لم تؤكّده خلال %lld ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Versuch wird ohne Bestätigung in %lld s abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trial will be cancelled if you don’t confirm within %lld seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La prueba se cancelará si no se confirma en %lld s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’essai sera annulé s’il n’est pas confirmé dans %lld s."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La prova verrà annullata se non la confermi entro %lld s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 秒以内に確認しないと、テストは取り消されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld초 안에 확인하지 않으면 테스트가 취소됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teste será cancelado se não for confirmado em %lld s."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "若未在 %lld 秒内确认，测试将取消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若未在 %lld 秒內確認，測試將取消。"
          }
        }
      }
    },
    "L’heure est automatique. Le pays reste votre choix et sera vérifié par le cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوقت يُحدد تلقائياً سيؤكد الإطار الصوري البلد الذي تختاره."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Uhrzeit wird automatisch eingestellt. Der Bildrahmen bestätigt das von Ihnen gewählte Land."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The time is set automatically. The frame will verify the country you choose."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La hora se fija automáticamente. El fotograma verificará el país que elijas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’heure est automatique. Le pays reste votre choix et sera vérifié par le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'ora è impostata automaticamente. La cornice fotografica confermerà il paese scelto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "時間が自動的に設定されます.フォトフレームはあなたが選んだ国を確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "시간은 자동으로 설정됩니다. 사진 프레임은 당신이 선택한 나라를 확인합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A hora é definida automaticamente. O quadro da foto irá verificar o país escolhido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "时间自动设置.相框架将验证您选择的国家."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "我們的時間自動設定.這張照片會證明你選擇的國家."
          }
        }
      }
    },
    "L’histoire commence ici": {
