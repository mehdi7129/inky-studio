    "Vous pouvez ajouter des photos et choisir leur programmation. Le propriétaire gère les accès et la configuration du cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يمكنك إضافة الصور وتعيين جدول أعمالهم يدير المالك إعدادات الوصول وإعدادات إطار الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sie können Fotos hinzufügen und ihren Zeitplan festlegen. Der Eigentümer verwaltet den Zugriff und die Einstellungen des Bildrahmens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can add photos and set their schedule. The owner manages access and the frame’s settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes añadir fotos y establecer su horario. El propietario gestiona el acceso y la configuración del fotograma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajouter des photos et choisir leur programmation. Le propriétaire gère les accès et la configuration du cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puoi aggiungere foto e impostare il loro programma. Il proprietario gestisce l'accesso e le impostazioni del fotogramma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "写真を追加してスケジュールを設定できますオーナーはアクセスと写真フレームの設定を管理します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진을 추가하고 일정을 설정할 수 있습니다. 소유자는 액세스 및 사진 프레임 설정을 관리합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Podes adicionar fotos e definir o horário. O proprietário gerencia a configuração do acesso e do quadro fotográfico."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "你可以添加照片,设置时间表.拥有者管理访问和相框架的设置."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您可以添加照片並設定他們的時間表.照片的所有者管理攝影機及攝影機的設定."
          }
        }
      }
    },
