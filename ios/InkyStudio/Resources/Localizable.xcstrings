    "Utilisez Précédente et Suivante dans l’onglet Cadre pour changer de photo.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم «السابق» و«التالي» في علامة تبويب «الإطار» لتغيير الصورة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwenden Sie „Zurück“ und „Weiter“ im Tab „Rahmen“, um das Foto zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Previous and Next in the Frame tab to change photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa «Anterior» y «Siguiente» en la pestaña «Marco» para cambiar de foto."
          }
        },
        "fr": {
