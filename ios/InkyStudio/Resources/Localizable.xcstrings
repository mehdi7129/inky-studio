          }
        }
      }
    },
    "Le cadre essaie le nouveau réseau. L’ancien réseau reste disponible en cas d’échec.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إطار الصور يُجرب الشبكة الجديدة. إذا فشل ذلك، فإنه يبقى الشبكة السابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Foto-Rahmen probiert das neue Netzwerk. Wenn das scheitert, behält es das vorherige Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frame tries the new network. If that fails, it keeps the previous network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El fotograma prueba la nueva red. Si eso falla, se mantiene la red anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le cadre essaie le nouveau réseau. L’ancien réseau reste disponible en cas d’échec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il fotogramma prova la nuova rete. Se fallirà, conserverà la rete precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フレームは新しいネットワークを試していますもし失敗したら 前のネットワークを保持します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진 프레임은 새로운 네트워크를 시도합니다. 실패하면 이전 네트워크를 유지합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O quadro fotográfico tenta a nova rede. Se isso falhar, mantém a rede anterior."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
