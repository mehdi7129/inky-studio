            "value": "تقييد جهاز يمنع وصول الكاميرا. يمكنك اختيار صورة من الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Gerätebeschränkung blockiert den Zugang der Kamera. Sie können ein Bild aus Fotos auswählen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device restriction blocks camera access. You can choose an image from Photos."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una restricción de dispositivo bloquea el acceso de la cámara. Puedes elegir una imagen de Fotos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une restriction de cet appareil empêche l’accès à la caméra. Vous pouvez choisir une image dans Photos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Una restrizione al dispositivo blocca l'accesso della telecamera. Puoi scegliere un'immagine da Photos."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "装置の制限はカメラへのアクセスを阻害します写真から画像を選択できます."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "장치 제한은 카메라 접근을 차단합니다. 사진에서 이미지를 선택할 수 있습니다."
          }
        },
        "pt": {
