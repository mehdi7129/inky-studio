    "Autorisez Réseau local et Appareil photo quand iOS le demande. Certains réseaux invités empêchent les appareils de communiquer entre eux.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسمح بالوصول إلى الشبكة المحلية والكاميرا عندما يطلب iOS ذلك. قد تمنع بعض شبكات الضيوف الأجهزة من الاتصال ببعضها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlauben Sie den Zugriff auf lokales Netzwerk und Kamera, wenn iOS es verlangt. Einige Gastnetzwerke verhindern, dass Geräte miteinander in Kontakt treten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Local Network and Camera access when iOS asks. Some guest networks prevent devices from reaching each other."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite el acceso a la red local y a la cámara cuando iOS lo solicite. Algunas redes de invitados impiden que los dispositivos se alcancen entre sí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez Réseau local et Appareil photo quand iOS le demande. Certains réseaux invités empêchent les appareils de communiquer entre eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permettere l'accesso alla rete locale e alla fotocamera quando iOS richiede. Alcune reti ospiti impediscono ai dispositivi di raggiungere l'un l'altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iOSの確認画面で「ローカルネットワーク」と「カメラ」へのアクセスを許可してください。一部のゲスト用ネットワークでは、端末同士が通信できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS이 요청할 때 로컬 네트워크와 카메라에 액세스 할 수 있습니다. 일부 게스트 네트워크는 기기가 서로 접근하지 못하게 합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir acesso à Rede Local e à câmera quando o iOS pedir. Algumas redes de hóspedes impedem os dispositivos de se alcançarem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在iOS要求时,允许本地网络和摄像头访问.一些客户网络阻止设备相互接触."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在 iOS 要求時,有些客戶網絡阻止設備互相接觸."
          }
        }
      }
    },
    "Autorisez la caméra dans les réglages iOS pour scanner le QR du cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "السماح للوصول إلى الكاميرا في إعدادات iOS لمتسح رمز QR الإطار الصوري."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlauben Sie den Zugang der Kamera in iOS-Einstellungen, um den QR-Code des Fotorahmens zu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow Camera access in iOS Settings to scan the frame’s QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir el acceso de la cámara en la configuración de iOS para escanear el código QR del marco de la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez la caméra dans les réglages iOS pour scanner le QR du cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permettere l'accesso della telecamera nelle impostazioni iOS per scansionare il codice QR del fotogramma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS設定でカメラにアクセスして写真フレームのQRコードをスキャンします."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "iOS 설정에서 카메라 접속을 허용하여 사진 프레임 QR 코드를 스캔합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permitir o acesso da câmera nas configurações do iOS para escanear o código QR do quadro da foto."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在iOS设置中允许摄像头访问,以扫描相框架的QR码."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "請在 iOS 設定中允許使用相機，以掃描相框的 QR Code。"
          }
        }
      }
    },
    "Autorisez le Bluetooth dans les réglages de l’app.": {
