          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa «Precedente» e «Successiva» nella scheda «Cornice» per cambiare foto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「フレーム」タブの「前の写真」または「次の写真」をタップして写真を切り替えます。"
          }
        },
        "ko": {
