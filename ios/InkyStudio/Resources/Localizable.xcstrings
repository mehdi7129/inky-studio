    "Placez le QR affiché sur le cadre dans le viseur.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ضع رمز QR الإطار الصوري في جهاز العثور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Legen Sie den QR-Code des Foto-Rahmens in den Sucher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Position the frame’s QR code in the viewfinder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encuadra el código QR que aparece en el marco digital."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le QR affiché sur le cadre dans le viseur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inquadra il codice QR visualizzato sulla cornice digitale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォトフレームのQRコードをビューンダーに配置する."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "액자에 표시된 QR 코드를 화면 안에 맞추세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Coloque o código QR do quadro da foto no visor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将相框上显示的二维码对准取景框。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將相框上顯示的 QR Code 對準取景框。"
          }
        }
      }
    },
    "Placez le QR du cadre ou l’invitation d’un autre iPhone dans le viseur. Pour les photos, rejoignez le même Wi-Fi que le cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه الكاميرا نحو رمز QR على الإطار أو رمز الدعوة على iPhone آخر. لمشاركة الصور، اتصل بشبكة Wi-Fi نفسها التي يستخدمها الإطار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Richten Sie die Kamera auf den QR-Code des Rahmens oder auf die Einladung auf einem anderen iPhone. Verbinden Sie sich zum Senden von Fotos mit demselben WLAN wie der Rahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the frame’s QR code or an invitation from another iPhone. To share photos, join the same Wi-Fi network as the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encuadra el código QR del marco o la invitación de otro iPhone. Para enviar fotos, conéctate a la misma red Wi-Fi que el marco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez le QR du cadre ou l’invitation d’un autre iPhone dans le viseur. Pour les photos, rejoignez le même Wi-Fi que le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Inquadra il codice QR della cornice o l’invito su un altro iPhone. Per inviare foto, connettiti alla stessa rete Wi-Fi della cornice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フレームのQRコード、または別のiPhoneの招待コードを読み取ってください。写真を送るにはフレームと同じWi-Fiに接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "액자의 QR 코드나 다른 iPhone에 표시된 초대 코드를 화면에 맞추세요. 사진을 보내려면 액자와 같은 Wi-Fi에 연결하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Enquadre o código QR da moldura ou o convite apresentado noutro iPhone. Para enviar fotografias, ligue-se à mesma rede Wi-Fi que a moldura."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "将相框二维码或另一台 iPhone 上的邀请二维码对准取景框。发送照片时，请连接到与相框相同的 Wi-Fi 网络。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "將相框的 QR Code 或另一部 iPhone 上的邀請 QR Code 對準取景框。傳送照片時，請連線至與相框相同的 Wi-Fi 網路。"
          }
        }
      }
    },
