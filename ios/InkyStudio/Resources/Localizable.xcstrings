    "Restez près du cadre. Son identité sera vérifiée avant de transmettre votre mot de passe Wi-Fi.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إبقى بالقرب من الإطار الصوري سيتم التحقق من هويته قبل إرسال كلمة المرور الخاصة بك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bleiben Sie in der Nähe des Bildrahmens. Ihre Identität wird überprüft, bevor Ihr Wi-Fi-Passwort gesendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay near the frame. Its identity will be verified before your Wi-Fi password is sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quédate cerca del fotograma. Su identidad será verificada antes de que se envíe su contraseña Wi-Fi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restez près du cadre. Son identité sera vérifiée avant de transmettre votre mot de passe Wi-Fi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stai vicino al fotogramma. La sua identità verrà verificata prima che venga inviata la password Wi-Fi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォトフレーム近くでワイ・ファイパスワードが送信される前に その身分が確認されます."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진 프레임 근처에 있어 Wi-Fi 비밀번호가 전송되기 전에 그 아이덴티티가 확인됩니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Fique perto do quadro. Sua identidade será verificada antes de a senha Wi-Fi ser enviada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "靠近相框.在您的Wi-Fi密码发送之前,将验证其身份."
          }
        },
        "zh-Hant": {
          "stringUnit": {
