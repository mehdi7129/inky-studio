    "Créez un QR code à scanner avec Inky Studio sur l’autre iPhone pour lui donner accès aux photos du cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "قم بإنشاء رمز QR وتسحنها في Inky Studio على جهاز iPhone الآخر لتمنح الوصول إلى الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erstellen Sie einen QR-Code und scannen Sie ihn in Inky Studio auf dem anderen iPhone, um Fotozugang zu gewähren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create a QR code and scan it in Inky Studio on the other iPhone to grant photo access."
          }
