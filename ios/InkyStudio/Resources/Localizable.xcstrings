    "Huit cadres sont déjà enregistrés. Oubliez un cadre avant d’en adopter un autre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ثمانية إطارات تم حفظها بالفعل. انسى واحدة قبل أن تجمع أخرى"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Acht Bilder sind bereits gespeichert. Vergessen Sie einen, bevor Sie einen anderen paaren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eight frames are already saved. Forget one before pairing another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ocho cuadros ya están guardados. Olvídate de uno antes de emparejar otro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Huit cadres sont déjà enregistrés. Oubliez un cadre avant d’en adopter un autre."
