        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "セッションの有効期限が切れたか、パスワードが違います。フレームに再接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "세션이 만료되었거나 비밀번호가 올바르지 않습니다. 액자에 다시 연결하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "A sessão expirou ou a palavra-passe está incorreta. Volte a ligar-se à moldura."
