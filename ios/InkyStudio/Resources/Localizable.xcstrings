    "Votre session a expiré ou le mot de passe est incorrect. Reconnectez-vous à votre cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "انتهت صلاحية الجلسة أو أن كلمة المرور غير صحيحة. أعد الاتصال بالإطار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ihre Sitzung ist abgelaufen oder das Passwort ist falsch. Verbinden Sie sich erneut mit dem Rahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your session expired or the password is incorrect. Reconnect to the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tu sesión ha caducado o la contraseña es incorrecta. Vuelve a conectar con el marco."
