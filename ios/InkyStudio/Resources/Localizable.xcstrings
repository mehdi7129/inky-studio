    "Le Raspberry est injoignable. Vérifiez son adresse, le Wi-Fi et l’autorisation Réseau local dans Réglages iOS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعذّر الاتصال بـ Raspberry Pi. تحقّق من عنوانه واتصال Wi-Fi وإذن الشبكة المحلية في إعدادات iOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Raspberry Pi ist nicht erreichbar. Prüfen Sie seine Adresse, das WLAN und die Berechtigung für das lokale Netzwerk in den iOS-Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t reach the Raspberry Pi. Check its address, the Wi-Fi connection and the Local Network permission in iOS Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede conectar al Raspberry Pi. Comprueba su dirección, la red Wi-Fi y el permiso de red local en los ajustes de iOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Raspberry est injoignable. Vérifiez son adresse, le Wi-Fi et l’autorisation Réseau local dans Réglages iOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile raggiungere il Raspberry Pi. Controlla l’indirizzo, la rete Wi-Fi e l’autorizzazione alla rete locale nelle impostazioni di iOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raspberry Piに接続できません。アドレス、Wi-Fi、iOSの設定でローカルネットワークへのアクセス許可を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Raspberry Pi에 연결할 수 없습니다. 주소와 Wi-Fi 연결, iOS 설정의 로컬 네트워크 접근 권한을 확인하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Não foi possível ligar ao Raspberry Pi. Verifique o endereço, a rede Wi-Fi e a permissão de acesso à rede local nas definições do iOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无法连接到 Raspberry Pi。请检查其地址、Wi-Fi 连接以及 iOS 设置中的本地网络权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "無法連線至 Raspberry Pi。請檢查其位址、Wi-Fi 連線及 iOS 設定中的本機網路權限。"
          }
        }
      }
    },
    "Le Wi-Fi est configuré, mais l’identifiant sécurisé n’a pas pu être transféré. L’accès actuel à vos photos est conservé.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ويفاي جاهزة لا يمكن نقل شهادة الأمان. لا يزال بإمكانك الوصول إلى الصور الحالية"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Wi-Fi ist eingerichtet. Die gesicherte Auskunft konnte nicht übertragen werden. Ihr aktueller Fotozugang ist immer noch verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi-Fi is set up. The secure credential couldn’t be transferred. Your current photo access is still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El Wi-Fi está configurado. La credencial de seguridad no pudo ser transferida. Su acceso actual a la foto todavía está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Wi-Fi est configuré, mais l’identifiant sécurisé n’a pas pu être transféré. L’accès actuel à vos photos est conservé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il Wi-Fi è pronto. La credenziale sicura non poteva essere trasferita. Il tuo accesso alla foto attuale è ancora disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wi-Fiが設定されています.安全な証明書は転送できない.あなたの現在の写真アクセスはまだ利用可能です"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "와이파이가 준비됐어 보안 자격증은 전송될 수 없었습니다. 현재 사진에 대한 접근은 여전히 가능합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O Wi-Fi está configurado. A credencial segura não podia ser transferida. O seu acesso atual à foto ainda está disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "无线电已经设置.安全证书无法转移.你目前的照片访问仍然可用."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "網路上有無線連線.這份安全證書無法轉移.您目前的照片仍可供使用."
          }
        }
      }
    },
    "Le Wi-Fi est configuré. La nouvelle connexion photo n’a pas pu être vérifiée ; la connexion précédente est conservée.": {
      "localizations": {
        "ar": {
          "stringUnit": {
