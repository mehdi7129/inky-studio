    "Le cadre vérifie ses réglages. Une étape déjà envoyée ne sera pas relancée automatiquement.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إطار الصور يتحقق من إعداداته لن تكرر الخطوة المقدمة تلقائياً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bildrahmen überprüft seine Einstellungen. Es wird nicht automatisch einen eingereichten Schritt wiederholen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
