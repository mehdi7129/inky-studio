        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sono già salvati otto quadri. Dimentica una prima di accoppiare un'altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "8つのフレームが保存されています.もう\"つを組み合わせる前に忘れてください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "8개의 프레임이 이미 저장되어 있습니다. 다른 하나를 짝짓기 전에 하나를 잊어버리세요."
          }
        },
        "pt": {
