    "L’identité du cadre ne correspond pas au QR. Aucun secret n’a été envoyé.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "هوية إطار الصور لا تتطابق مع رمز QR. لم يتم إرسال أوراق اعتماد"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Identität des Foto-Rahmens entspricht nicht dem QR-Code. Keine Auskunft wurde gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
