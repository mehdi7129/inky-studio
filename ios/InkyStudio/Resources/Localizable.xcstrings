        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "您將控制攝影機的設定和設備的使用."
          }
        }
      }
    },
    "Lire le QR synthétique": {
      "localizations": {
        "ar": {
          "stringUnit": {
