    "Votre accès enregistré est conservé jusqu’à la validation du nouveau QR.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "الوصول المحفوظ يبقى في مكانه حتى يتم التحقق من رمز QR الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
