          }
        }
      }
    },
    "Le certificat du cadre n’est pas valide. Vérifiez la date de l’iPhone puis scannez à nouveau le QR du cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "شهادة إطار الصور غير صالحة. تحقق من تاريخ هاتفك وأمسح رمز QR إطار الصور مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Bildrahmenzertifikat ist ungültig. Überprüfen Sie das Datum Ihres iPhone und scannen Sie den QR-Code des Foto-Rahmens erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frame’s certificate is invalid. Check your iPhone’s date and scan the frame’s QR code again."
