    "Prenez une photo ou choisissez-en une dans Photos, puis ajustez son cadrage.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورة أو اختر واحدة من تطبيق الصور، ثم اضبط اقتصاصها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Machen Sie ein Foto oder wählen Sie eines aus Fotos, dann passen Sie die Ernte an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from Photos, then adjust the crop."
          }
        },
        "es": {
          "stringUnit": {
