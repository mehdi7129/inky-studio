    },
    "Prenez une photo ou choisissez-en une dans Photos. Ajustez son cadrage, puis ajoutez-la à la file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التقط صورة أو اختر واحدة من تطبيق الصور. اضبط اقتصاصها، ثم أضفها إلى قائمة الانتظار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Machen Sie ein Foto oder wählen Sie eines aus Fotos. Schneiden Sie es und fügen Sie es dann zur Warteschlange hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take a photo or choose one from Photos. Crop it, then add it to the queue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toma una foto o escoge una de las fotos. Recortarlo, y luego agregarlo a la cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenez une photo ou choisissez-en une dans Photos. Ajustez son cadrage, puis ajoutez-la à la file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Prendi una foto o scegli una da Photos. La taglia, poi aggiungela alla coda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮るか、「写真」から選んでください。表示範囲を調整してから、キューに追加します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진을 찍거나 사진에서 하나를 선택하세요. 잘라서 줄을 붙여라."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tire uma foto ou escolha uma de Fotos. Corta-o, depois adiciona-o à fila."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "拍照或从照片中选择一个.然后把它加到排队里."
          }
