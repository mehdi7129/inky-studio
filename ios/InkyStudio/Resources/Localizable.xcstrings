            "state": "needs_review",
            "value": "「액자」 탭에서 「이전 사진」과 「다음 사진」을 눌러 사진을 바꾸세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use «Anterior» e «Seguinte» no separador «Moldura» para mudar de fotografia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
