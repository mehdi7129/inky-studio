    "Choisissez le pays où le cadre sera utilisé. L’heure sera fournie automatiquement par cet iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر البلد الذي سيتم فيه استخدام إطار الصور. هذا الآيفون يوفر الوقت تلقائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wählen Sie das Land aus, in dem der Bildrahmen verwendet wird. Dieses iPhone versorgt die Zeit automatisch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the country where the frame will be used. This iPhone supplies the time automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Seleccione el país en el que se utilizará el marco de la foto. Este iPhone suministra el tiempo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le pays où le cadre sera utilisé. L’heure sera fournie automatiquement par cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli il paese in cui si utilizzerà il quadro fotografico. Questo iPhone alimenta il tempo automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "フォトフレームが使用される国を選択します.このiPhoneは自動的に時間を供給します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "사진 프레임이 사용되는 국가를 선택하십시오. 이 아이폰은 자동으로 시간을 공급합니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha o país onde o quadro de foto será utilizado. Este iPhone fornece o tempo automaticamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择将使用相框架的国家.这款iPhone自动提供时间."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇使用相框架的國家.這款iPhone自動提供時間."
          }
        }
      }
    },
    "Choisissez un réseau personnel WPA2. Les réseaux ouverts, d’entreprise ou avec portail de connexion ne sont pas pris en charge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اختر شبكة شخصية WPA2. الشبكات المفتوحة والشركية والسجل غير مدعومة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wählen Sie ein persönliches WPA2-Netzwerk. Öffnete, Unternehmens- und Anmelde-Netzwerke werden nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a WPA2 personal network. Open, enterprise and sign-in networks are unsupported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elige una red personal WPA2. Las redes abiertas, empresariales y de inicio de sesión no son compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un réseau personnel WPA2. Les réseaux ouverts, d’entreprise ou avec portail de connexion ne sont pas pris en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Scegli una rete personale WPA2. Le reti aperte, aziendali e di iscrizione non sono supportate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WPA2 の個人ネットワークを選択してください.オープン・エンタープライズ・サインイン・ネットワークはサポートされていません."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "WPA2 개인 네트워크를 선택하세요. 오픈, 엔터프라이즈 및 로그인 네트워크는 지원되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Escolha uma rede pessoal WPA2. As redes abertas, empresariais e de login não são suportadas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "选择一个WPA2个人网络.开放,企业和登录网络不支持."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "選擇一個WPA2個人網絡.沒有支持開放,企業及登記網絡."
          }
        }
      }
    },
