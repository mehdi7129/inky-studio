    "Les deux iPhone doivent pouvoir rejoindre le même réseau Wi-Fi que le cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "يجب أن يكون كلتا الهاتفين قادرين على الاتصال بنفس شبكة Wi-Fi مثل إطار الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beide iPhones müssen in der Lage sein, sich an das gleiche Wi-Fi-Netzwerk zu verbinden wie der Fotorahmen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both iPhones must be able to join the same Wi-Fi network as the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambos iPhones deben ser capaces de conectarse a la misma red Wi-Fi que el fotograma."
          }
        },
        "fr": {
