    " L’identifiant sécurisé n’a pas pu être mis à jour sur cet iPhone.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": " لا يمكن تحديث الإثباتات الآمنة على هذا الآيفون."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Die sichere Anmeldung konnte nicht auf diesem iPhone aktualisiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " The secure credential couldn’t be updated on this iPhone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " La credencial de seguridad no pudo actualizarse en este iPhone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " L’identifiant sécurisé n’a pas pu être mis à jour sur cet iPhone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " Le credenziali sicure non sono state aggiornate su questo iPhone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": " このiPhoneでは安全認証は更新できませんでした."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": " 보안 인증서는 이 아이폰에서 업데이트될 수 없었습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": " A credencial segura não pode ser atualizada neste iPhone."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": " 在iPhone上无法更新安全凭证."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": " 這部iPhone上無法更新安全認證."
          }
        }
      }
    },
