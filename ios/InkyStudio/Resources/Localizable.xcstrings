    "Connexion refusée ou session expirée. Vérifiez le mot de passe du cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تم رفض الوصول أو انتهت الجلسة تحقق من كلمة المرور في إطار الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zugriff verweigert oder Sitzung abgelaufen. Überprüfen Sie das Passwort des Bildrahmens."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access denied or session expired. Check the frame’s password."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se negó el acceso o la sesión expiró. Compruebe la contraseña del fotograma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion refusée ou session expirée. Vérifiez le mot de passe du cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "L'accesso è stato negato o la sessione è scaduta. Controlla la password del fotogramma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "アクセス拒否またはセッション終了フォトフレームのパスワードを確認する"
