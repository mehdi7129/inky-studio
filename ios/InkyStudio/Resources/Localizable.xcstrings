    "Si aucun QR n’est visible, consultez l’aide de votre cadre. L’app ne prépare pas un Raspberry vierge.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا لم يظهر رمز QR، فراجع دليل إعداد الإطار. ثبّت InkyOS على Raspberry Pi أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn Sie einen QR-Code nicht sehen können, überprüfen Sie den Einrichtungsanweis des Foto-Rahmens. Installieren Sie InkyOS zuerst auf Ihrem Raspberry Pi."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you can’t see a QR code, check the frame’s setup guide. Install InkyOS on your Raspberry Pi first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si no puede ver un código QR, consulte la guía de configuración del fotograma. Instala InkyOS en tu Raspberry Pi primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aucun QR n’est visible, consultez l’aide de votre cadre. L’app ne prépare pas un Raspberry vierge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se non riesci a vedere un codice QR, controlla la guida di configurazione del fotogramma. Installa InkyOS sul tuo Raspberry Pi prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードが表示されない場合は、フレームのセットアップガイドを確認してください。あらかじめRaspberry PiにInkyOSをインストールしておく必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "QR 코드를 볼 수 없다면 사진 프레임 설정 안내서를 확인하세요. 먼저 라즈베리 파이에 인키오스를 설치하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se não puder ver um código QR, consulte o guia de configuração do quadro de fotos. Instale o InkyOS no seu Raspberry Pi primeiro."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果找不到二维码，请查阅相框的帮助说明。请先在 Raspberry Pi 上完成相框软件的安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "如果您無法查看QR圖碼,首先要將InkyOS安裝在你的Raspberry Pi上."
          }
        }
      }
    },
