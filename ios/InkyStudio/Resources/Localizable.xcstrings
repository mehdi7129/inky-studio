    "Activez le Bluetooth pour chercher le cadre.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تشغيل بلوتوث للعثور على إطار الصور."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Schalten Sie Bluetooth ein, um den Bildrahmen zu finden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Bluetooth to find the frame."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Encienda el Bluetooth para encontrar el marco de la foto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez le Bluetooth pour chercher le cadre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Accendi il Bluetooth per trovare il fotogramma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ブルーツをオンにして写真のフレームを見つけます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "블루투스를 켜서 사진 프레임을 찾아보세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ligue o Bluetooth para encontrar o quadro da foto."
          }
        },
