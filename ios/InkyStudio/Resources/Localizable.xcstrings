          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
            "value": "這張照片的身分改變了.請將它再加上實體相框."
          }
        }
      }
    },
    "L’identité du cadre ne correspond pas au QR code.": {
      "localizations": {
