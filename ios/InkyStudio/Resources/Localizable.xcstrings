    "Affichage avec Suivante ou selon votre programmation.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "اضغط على «التالي» لعرض الصورة، أو دعها تُعرض وفقًا للجدول."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tippen Sie auf „Weiter“, um das Foto anzuzeigen, oder warten Sie auf den geplanten Wechsel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Next to show it or let your schedule do it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Pulsa «Siguiente» para mostrar la foto, o espera a que se muestre según la programación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affichage avec Suivante ou selon votre programmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Tocca «Successiva» per mostrare la foto oppure attendi il cambio programmato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「次の写真」をタップするか、設定したスケジュールに従って表示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "「다음 사진」을 눌러 표시하거나 설정한 일정에 따라 표시하세요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Toque em «Seguinte» para mostrar a fotografia ou aguarde pela mudança programada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "轻点“下一张”立即显示照片，或按设定的时间自动显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "needs_review",
