          }
        }
      }
    },
    "Le cadre enregistre cet essai avant de quitter son Wi-Fi temporaire.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "إطار الصور يحفظ المحاكمة قبل مغادرة شبكة Wi-Fi المؤقتة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Bildrahmen speichert die Studie, bevor er sein vorübergehendes Wi-Fi-Netzwerk verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The frame saves the trial before leaving its temporary Wi-Fi network."
          }
        },
        "es": {
          "stringUnit": {
