<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleDisplayName</key><string>Inky Studio</string>
<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
<key>LSRequiresIPhoneOS</key><true/>
<key>UILaunchScreen</key><dict/>
<key>UISupportedInterfaceOrientations</key><array><string>UIInterfaceOrientationPortrait</string></array>
<key>NSCameraUsageDescription</key><string>Prenez une photo pour votre cadre ou scannez son QR de connexion Bluetooth. Les images ne sont pas enregistrées automatiquement dans votre photothèque.</string>
<key>NSBluetoothAlwaysUsageDescription</key><string>Inky Studio utilise le Bluetooth pour reconnaître votre cadre et configurer son réseau Wi-Fi, même hors de votre réseau habituel.</string>
<key>NSLocalNetworkUsageDescription</key><string>Inky Studio se connecte à votre Raspberry sur le même réseau Wi-Fi pour gérer les photos de votre cadre.</string>
<key>NSFaceIDUsageDescription</key><string>Face ID autorise l’utilisation du mot de passe de votre cadre enregistré sur cet iPhone.</string>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
<!-- Mbed TLS adds bundled encryption. Use App Store Connect's manual export
     questionnaire until Apple supplies an approved compliance code. Do not
     declare an exemption or invent an ITSEncryptionExportComplianceCode. -->
</dict></plist>
