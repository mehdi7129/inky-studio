{
  "definitions": {
    "APState": {
      "additionalProperties": false,
      "properties": {
        "ap_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "boot_id": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "country": {
          "const": "FR"
        },
        "expires_boottime_ns": {
          "maximum": 9223372036854775807,
          "minimum": 0,
          "type": "integer"
        },
        "host": {
          "const": "192.168.4.1"
        },
        "interface": {
          "const": "wlan0"
        },
        "passphrase": {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
        },
        "port": {
          "const": 9443
        },
        "ssid": {
          "pattern": "^Inky-[0-9a-f]{8}$",
          "type": "string"
        },
        "state": {
          "enum": [
            "active",
            "stopped",
            "expired"
          ]
        }
      },
      "required": [
        "state",
        "boot_id",
        "ap_id",
        "country",
        "interface",
        "ssid",
        "passphrase",
        "host",
        "port",
        "expires_boottime_ns"
      ],
      "type": "object"
    },
    "Workflow": {
