          "type": "string"
        },
        "initialization_intent": {
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
          "type": "string"
        },
        "initialization_receipt_digest": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "spki_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "initialization_intent",
        "initialization_receipt_digest",
        "frame_id",
        "spki_sha256"
      ],
      "type": "object"
    }
